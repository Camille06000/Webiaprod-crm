# --- Required ---

# Connection string Postgres
# Local (VPS):     postgres://webiaprod:PASSWORD@127.0.0.1:5432/webiaprod_crm
# Neon (cloud):    postgres://user:password@xxxx-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://webiaprod:CHANGE_ME@127.0.0.1:5432/webiaprod_crm

# --- Optional ---

# Protège l'endpoint /api/cron/daily contre les appels non autorisés.
# Génère avec : openssl rand -hex 32
CRON_SECRET=change-me

# Identité émetteur (utilisée par les subagents de rédaction)
# JEROME_LAST_NAME=
CALENDLY_URL=https://calendly.com/jerome-webiaprod

# Pour les futures intégrations de l'agent quotidien :
# Apify (Google Maps scraper) — récupère ton token sur console.apify.com/account/integrations
APIFY_TOKEN=

# Gmail OAuth (création de drafts via API Gmail)
# Étapes : console.cloud.google.com → projet → Gmail API → OAuth Client (Desktop)
# Puis : node scripts/gmail-oauth.mjs  (sur ton PC, pas sur le VPS) pour récupérer le refresh token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=jerome@webiaprod.fr
GMAIL_FROM_NAME=Jérôme Webiaprod

# Identité émetteur (utilisée par les drafts générés par défaut)
JEROME_LAST_NAME=
