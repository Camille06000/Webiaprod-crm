# --- Required ---

# Connection string Neon Postgres
# Récupère-la sur https://console.neon.tech → ton projet → Connection Details
# (utilise la "Pooled connection" pour Vercel)
DATABASE_URL=postgres://user:password@xxxx-pooler.neon.tech/dbname?sslmode=require

# --- Optional ---

# Protège l'endpoint /api/cron/daily contre les appels non autorisés.
# Génère une chaîne aléatoire forte (ex. `openssl rand -hex 32`).
# Vercel Cron envoie automatiquement l'en-tête Authorization avec ce secret.
CRON_SECRET=change-me

# Pour les futures intégrations de l'agent quotidien :
# APIFY_TOKEN=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# CALENDLY_URL=https://calendly.com/.../demo-15min
# JEROME_LAST_NAME=
