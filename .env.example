# --- Required ---

# Connection string Postgres
# Local (VPS):     postgres://webiaprod:PASSWORD@127.0.0.1:5432/webiaprod_crm
# Neon (cloud):    postgres://user:password@xxxx-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://webiaprod:CHANGE_ME@127.0.0.1:5432/webiaprod_crm

# --- Optional ---

# Protège l'endpoint /api/cron/daily contre les appels non autorisés.
# Génère avec : openssl rand -hex 32
CRON_SECRET=change-me

# Identité émetteur (utilisée par les subagents de rédaction)
# JEROME_LAST_NAME=
CALENDLY_URL=https://calendly.com/jerome-webiaprod

# Pour les futures intégrations de l'agent quotidien :
# APIFY_TOKEN=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
